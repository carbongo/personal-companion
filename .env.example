# =============================================================================
# personal-companion — configuration reference
# Copy to `.env` and edit. Everything has a sensible default except secrets.
# Vars are grouped by subsystem; some land in later phases (see docs/roadmap.md).
# Nothing here should ever contain another real person's private data in a
# committed file — keep your filled-in `.env` and persona/ out of git.
# =============================================================================

# --- app ---------------------------------------------------------------------
# Display name your companion goes by, and what it calls you. These feed the
# persona; the full personality lives in your persona file (see docs/configuration.md).
COMPANION_NAME="Companion"
COMPANION_OWNER="friend"
# IANA timezone used for day-bucketing, summaries, and the date it sees.
TZ="UTC"
# Where the SQLite database and uploads are stored (mounted as a volume in Docker).
DATA_DIR="./data"
# Port for the web interface (admin + built-in chat).
PORT="8080"
# Relaunch automatically after a Settings save so the new .env applies with no
# manual step. The process simply exits and is expected to be brought back by a
# supervisor (launchd KeepAlive, Docker `restart:`, systemd `Restart=`). Leave
# "false" if nothing supervises the process, or it would just stop on save.
AUTO_RESTART_ON_SAVE="false"

# --- web interface auth ------------------------------------------------------
# The web UI is reachable to anyone who can hit the port, so protect it.
# Set a password; leave empty ONLY if the app sits behind Tailscale / a trusted proxy.
WEB_AUTH_PASSWORD=""

# --- brain (LLM provider) ----------------------------------------------------
# Provider: "ollama" (local, default), "openai-compatible", or "claude-cli"
# (spawns the `claude` command installed on this machine — no API key, the CLI
# brings its own sign-in; set LLM_MODEL to an alias like "haiku"). ("anthropic" is
# planned; for now reach Anthropic models via an openai-compatible gateway.)
LLM_PROVIDER="ollama"
# Recommended local default. Pull it first: `ollama pull gemma4:12b`.
LLM_MODEL="gemma4:12b"
# Optional. Used only for turns that include an image, when LLM_MODEL can't see
# (e.g. a text-only model). Leave blank if LLM_MODEL is already vision-capable.
# For Ollama, pull a vision model first, e.g. `ollama pull qwen2.5vl:7b`.
LLM_VISION_MODEL=""
# Local Ollama endpoint. Default assumes Ollama runs on the same host.
LLM_OLLAMA_URL="http://localhost:11434"
# For hosted providers (openai-compatible / anthropic):
LLM_BASE_URL=""
LLM_API_KEY=""
# The Claude CLI command (provider "claude-cli"); resolved on PATH if bare.
LLM_CLAUDE_BIN="claude"
# Generation tuning.
LLM_TEMPERATURE="0.7"
LLM_NUM_CTX="8192"
LLM_MAX_TOKENS="1000"
# Reasoning/thinking: "true" | "false" | "low" | "medium" | "high".
# Ollama honors all of these. For openai-compatible, the effort levels
# (minimal/low/medium/high) map to `reasoning_effort` on reasoning-capable models
# (OpenAI o-series/GPT-5, OpenRouter); true/false defer to the endpoint default.
# claude-cli maps them to `--effort` (low/medium/high, plus xhigh/max), and since
# the CLI has no off switch, "false" becomes "low".
# Image turns always run with thinking off regardless (it's flaky with vision). If
# your model thinks a long time before answering, that's fine — the web chat keeps
# the stream alive with keepalives so the reply still arrives.
LLM_THINK="true"
LLM_TIMEOUT_MS="120000"
# How many prior messages from the live day to send each turn.
LLM_HISTORY_LIMIT="60"

# --- chat (web + Telegram) ---------------------------------------------------
# Batch a burst of quick messages into one turn — applies to BOTH the web chat
# and Telegram. The idle window is DYNAMIC: it waits IDLE ms after your first
# message, grows by STEP ms with each further message (you're clearly
# mid-thought), and never exceeds MAX ms. The burst flushes once you go quiet
# for the current window; the ceiling is the only bound (no total-time cap).
# e.g. 3000 / 2000 / 12000 → 3s, 5s, 7s, 9s, 11s, 12s, 12s…
# (The old TELEGRAM_BATCH_IDLE_MS / _MAX_MS still work as a fallback if unset.)
CHAT_BATCH_IDLE_MS="3000"
CHAT_BATCH_STEP_MS="2000"
CHAT_BATCH_MAX_MS="12000"

# --- Telegram channel (optional) ---------------------------------------------
# Create a bot with @BotFather, paste the token here. Leave empty to disable
# Telegram and use the built-in web chat only.
TELEGRAM_BOT_TOKEN=""
# Comma-separated Telegram user IDs allowed to talk to it (get yours from @userinfobot).
TELEGRAM_ALLOWED_USER_IDS=""
# Send each paragraph as its own message, like a person texting.
TELEGRAM_REPLY_SPLIT="true"

# --- Discord voice calls (optional, Phase 8) ---------------------------------
# Create a bot in the Discord developer portal, invite it to your server with
# voice permissions, paste the token here. Leave empty to disable Discord.
DISCORD_BOT_TOKEN=""
# Server (guild) and voice channel the bot joins calls in.
DISCORD_GUILD_ID=""
DISCORD_VOICE_CHANNEL_ID=""
# Discord user ID allowed to start/join a call; everyone else is ignored.
DISCORD_OWNER_USER_ID=""

# --- live call engine (optional, Phase 8) -------------------------------------
# Off by default: needs Discord above plus a working STT/TTS pipeline.
CALL_ENABLED="false"
# Optional LLM override for call turns; empty falls back to LLM_PROVIDER/LLM_MODEL.
CALL_PROVIDER=""
CALL_MODEL=""
# Voice-activity detection: "silero" (ONNX model, more accurate), "energy"
# (simple amplitude threshold, no model needed), or "auto" to prefer Silero
# when available and fall back to energy.
CALL_VAD_PROVIDER="auto"
CALL_VAD_THRESHOLD="0.5"
# Trailing silence (ms) that ends an utterance — the endpointing patience.
CALL_SILENCE_MS="700"
# Hard cap (ms) on a single utterance.
CALL_MAX_UTTERANCE_MS="30000"
# Whether the companion's own playback can be interrupted by new speech.
CALL_BARGE_IN="true"
# Utterances shorter than this (ms) are discarded as noise, not sent to STT.
CALL_MIN_SPEECH_MS="200"
# Endpointing patience (ms): base wait after trailing silence, an extended
# wait used when the utterance sounds unfinished (hesitation marker, dangling
# article, etc.), and a hard ceiling neither ever exceeds.
CALL_PATIENCE_MS="900"
CALL_PATIENCE_EXTENDED_MS="2000"
CALL_PATIENCE_MAX_MS="3500"

# --- memory ------------------------------------------------------------------
# How many past daily summaries to keep in context, and how many saved memories.
MEMORY_CONTEXT_DAYS="7"
MEMORY_LIMIT="40"
# Finished weeks and months are compacted into short digests of specifics; the
# time before the daily summaries rides in context as these instead.
MEMORY_DIGESTS="true"
MEMORY_CONTEXT_WEEKS="4"
MEMORY_CONTEXT_MONTHS="6"
# Model for summaries/digests/memory edits, on the same provider. Empty = LLM_MODEL.
MEMORY_MODEL=""

# --- writing first -------------------------------------------------------------
# Let the companion sometimes message you first over Telegram, after you've been
# quiet REACH_OUT_AFTER_HOURS, within REACH_OUT_HOURS (local, "start-end").
REACH_OUT="false"
REACH_OUT_HOURS="10-21"
REACH_OUT_AFTER_HOURS="24"
# Nightly roll-up schedule (5-field cron, in TZ) that compresses each day into a
# summary. Driven in-process — no external cron needed. Resilient to downtime:
# any day missed while the box was off/asleep is backfilled on the next boot and
# on a periodic safety tick.
MEMORY_SUMMARY_CRON="55 23 * * *"
# Let the nightly roll-up curate memory on its own: mine each day for lasting
# facts to save (e.g. "Alex works at a school as a software developer") and drop
# ones the day made wrong. This is the only automatic memory management — the
# companion does not write memory mid-conversation. "false" leaves the roll-up
# writing only the daily summary, and memory becomes yours to edit from the UI.
MEMORY_ROLLUP_EXTRACT="true"
# A weekly pass that steps back over the last week of daily summaries to
# consolidate memory — strengthen recurring patterns into confident facts, merge
# near-duplicates, drop one-offs, and fix shifts the daily pass is too myopic to
# catch. Requires MEMORY_ROLLUP_EXTRACT. "false" disables the weekly pass.
MEMORY_WEEKLY="true"
# When the weekly consolidation runs (5-field cron, in TZ). Default Monday 04:00,
# after the week's last daily roll-up. Caught up on boot / a safety tick if missed.
MEMORY_WEEKLY_CRON="0 4 * * 1"

# --- web access (optional egress) --------------------------------------------
# Lets the companion search the web / read links via <search>/<fetch> tags.
WEB_ACCESS="true"
# Search backend: "tavily" (needs key, better) or "duckduckgo" (keyless fallback).
WEB_SEARCH_PROVIDER="duckduckgo"
TAVILY_API_KEY=""
# Max web-lookup rounds per turn, results per search, chars per fetched page.
WEB_STEPS="3"
WEB_RESULTS="5"
WEB_PAGE_CHARS="6000"
# Advanced: per-request timeouts (ms) and max concurrent lookups per round.
WEB_SEARCH_TIMEOUT_MS="12000"
WEB_FETCH_TIMEOUT_MS="12000"
WEB_MAX_REQS="3"

# --- speech-to-text (optional, for voice notes) ------------------------------
# "off" | "openai" | "whisper-http" | "local".
#   openai       — hosted Whisper API; set STT_API_KEY (+ optional STT_MODEL).
#   whisper-http — any OpenAI-compatible /audio/transcriptions endpoint; set STT_API_URL.
#   local        — whisper.cpp on this machine (no daemon, no network): set
#                  STT_LOCAL_MODEL to a ggml/gguf model file; needs `whisper-cli`
#                  and `ffmpeg` on PATH. Used by Telegram voice notes and the
#                  web chat's mic / audio upload alike.
STT_PROVIDER="off"
STT_API_URL=""
STT_API_KEY=""
STT_MODEL="whisper-1"
# Local provider:
STT_LOCAL_MODEL=""            # e.g. ./data/models/ggml-base.bin
STT_LOCAL_BIN="whisper-cli"   # whisper.cpp CLI (PATH name or absolute path)
STT_FFMPEG_BIN="ffmpeg"       # ffmpeg (PATH name or absolute path)
STT_LANGUAGE="auto"           # spoken-language hint, or "auto" to detect
# Optional: a small model used only for a fast language-detection pass, so
# the main model can decode at a fixed language instead of auto-detecting
# itself. Empty means "don't do a separate detect pass".
STT_DETECT_MODEL=""           # e.g. ./data/models/ggml-tiny.bin
# The languages you actually speak, comma-separated (e.g. "en,ru"). Empty
# means unrestricted. A detected language outside this set is snapped to the
# closest member instead of being trusted outright.
STT_LANGUAGES=""
# Anti-hallucination thresholds — whisper sometimes "transcribes" silence or
# noise; these gate that out. See companion-core/call/hallucination-gate.ts.
# Passed to the decoder as -nth. whisper-cli does not report the no-speech
# probability back in any output mode, so nothing downstream can act on it
# locally — the decoder applies it internally and that is all.
STT_NO_SPEECH_THRESHOLD="0.6"
# Mean per-token probability below which a local transcript is discarded as
# invention rather than speech. This is the confidence whisper-cli does report
# (per-token "p" in its full JSON). Lower = more tolerant of mumbling.
STT_MIN_CONFIDENCE="0.5"
STT_MIN_CLIP_MS="400"         # clips shorter than this are not transcribed at all
STT_ENTROPY_THRESHOLD="2.4"
STT_LOGPROB_THRESHOLD="-1.0"

# --- text-to-speech (optional, for spoken replies) ---------------------------
# "off" | "openai" | "http" | "local". Default is "local" (Piper): no network
# round-trip, matching the project's local-first ethos and a latency priority.
#   openai — hosted speech API; set TTS_API_KEY (+ optional TTS_MODEL/TTS_VOICE).
#   http   — any OpenAI-compatible /audio/speech endpoint; set TTS_API_URL.
#   local  — Piper on this machine (no daemon, no network): set TTS_LOCAL_MODEL
#            to a Piper .onnx voice model file; needs the `piper` CLI on PATH.
#            Stays gracefully "off" until a model file is actually present.
TTS_PROVIDER="local"
TTS_API_URL=""
TTS_API_KEY=""
TTS_MODEL="tts-1"
TTS_VOICE=""
# Local provider:
TTS_LOCAL_MODEL=""    # e.g. ./data/models/en_US-lessac-medium.onnx
TTS_LOCAL_BIN="piper" # Piper CLI (PATH name or absolute path)
# Optional: a per-language voice map, "lang=path,lang=path", e.g.
# "en=./data/models/en_GB-cori-medium.onnx,ru=./data/models/ru_RU-irina-medium.onnx".
# A language with no entry falls back to TTS_LOCAL_MODEL.
TTS_LOCAL_MODEL_MAP=""
# Extra languages told apart from ru/en by letters only they use, e.g. "uk=єїґі".
TTS_SCRIPT_MARKERS=""
# When a reply is spoken — three independent triggers, any of them is enough:
#   mirror     — you sent a voice note, so it answers with one;
#   on request — you asked for this reply out loud (a channel's voice toggle);
#   sometimes  — the companion decides, by wrapping part of a reply in <speak>.
# The last one is off by default so audio is never unsolicited.
TTS_SPEAK_MIRROR="true"
TTS_SPEAK_ON_REQUEST="true"
TTS_SPEAK_SOMETIMES="false"
# Probability (0..1) that any reply is a voice note anyway, e.g. "0.15". 0 = off.
TTS_SPEAK_CHANCE="0"

# --- weather context (optional) ----------------------------------------------
# If set, the companion knows your local weather (Open-Meteo, no key needed).
WEATHER_LAT=""
WEATHER_LON=""
WEATHER_LOCATION_NAME=""
